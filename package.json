{
  "name": "tabletan",
  "version": "0.0.16",
  "description": "A powerful, flexible, and accessible data table component for React, built on top of TanStack Table.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
